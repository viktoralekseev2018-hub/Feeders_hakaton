{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One RAG chunk per JSONL line",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "agents",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\[\\]\\s]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000,
      "description": "Server additionally enforces 16000 UTF-8 bytes."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dzhanibekov",
          "savinykh",
          "ryazansky",
          "krikalev"
        ]
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "locator": {
          "type": "string",
          "maxLength": 512
        },
        "content_mode": {
          "type": "string",
          "maxLength": 64,
          "description": "summary or public_domain_excerpt; omitted for legacy corpora."
        },
        "relation_to_person": {
          "type": "string",
          "maxLength": 64,
          "description": "person, mission_context or role_background."
        },
        "language": {
          "type": "string",
          "maxLength": 16,
          "description": "Language of the indexed text, e.g. ru or en."
        }
      }
    },
    "requires_facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
